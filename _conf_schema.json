{
    "webui_url": {
        "type": "string",
        "description": "WebUI API地址",
        "default": "http://127.00.1:7860",
        "hint": "需要包含http://或https://前缀"
    },
    "verbose": {
        "type": "bool",
        "description": "控制回复的详略程度",
        "default": true,
        "hint": "设置为true时，将输出生成步骤，否则只输出图片"
    },
    "session_timeout_time": {
        "type": "int",
        "description": "会话判定超时时间，单位秒（s）",
        "default": 120,
        "hint": "默认为两分钟，根据需要修改"
    },
    "max_concurrent_tasks": {
        "type": "int",
        "description": "最大并发任务数",
        "default": 10,
        "hint": "根据显存大小进行设定，防止 OOM"
    },
    "enable_generate_prompt": {
        "type": "bool",
        "description": "启用使用LLM生成正向提示词",
        "default": true,
        "hint": "设置为true时启用"
    },
    "enable_upscale": {
        "type": "bool",
        "description": "启用高分辨率处理",
        "default": false,
        "hint": "设置为true时启用"
    },
    "enable_show_positive_prompt": {
        "type": "bool",
        "description": "启用输出正向提示词",
        "default": false,
        "hint": "设置为true时启用"
    },
    "enable_forward_message": {
        "type": "bool",
        "description": "启用合并转发消息",
        "default": false,
        "hint": "设置为true时，将以合并转发的形式发送图片和提示词"
    },
    "positive_prompt_global": {
        "type": "string",
        "description": "全局正面提示词",
        "default": "",
        "hint": "会自动附加到所有生成请求"
    },
    "negative_prompt_global": {
        "type": "string",
        "description": "全局负面提示词",
        "default": "(worst quality, low quality:1.4), deformed, bad anatomy",
        "hint": "会自动附加到所有生成请求"
    },
    "negative_prompt_whitelist": {
        "type": "string",
        "description": "白名单群聊专属负面提示词",
        "default": "",
        "hint": "仅在白名单群聊中生效，会覆盖全局负面提示词"
    },
    "whitelist_groups": {
        "type": "list",
        "description": "白名单群聊ID列表",
        "default": [],
        "items": {
            "type": "string"
        },
        "hint": "在此列表中的群聊将使用白名单专属配置"
    },
    "blacklist_groups": {
        "type": "list",
        "description": "黑名单群聊ID列表",
        "default": [],
        "items": {
            "type": "string"
        },
        "hint": "在此列表中的群聊将不响应绘画命令"
    },
    "default_params": {
        "type": "object",
        "description": "默认生成参数",
        "items": {
            "width": {
                "type": "int",
                "description": "图像宽度",
                "default": 512,
                "min": 64,
                "max": 1920,
                "hint": "范围64~1920，且必须为64的倍数"
            },
            "height": {
                "type": "int",
                "description": "图像高度",
                "default": 512,
                "min": 64,
                "max": 1920,
                "hint": "范围64~1920，且必须为64的倍数"
            },
            "steps": {
                "type": "int",
                "description": "步数",
                "default": 20,
                "min": 10,
                "max": 50
            },
            "sampler": {
                "type": "string",
                "description": "采样器",
                "default": "",
                "hint": "默认为空，使用 `/sd sampler list` 获取，使用 `/sd sampler set <index>` 设置"
            },
            "scheduler": {
                "type": "string",
                "description": "调度器",
                "default": "",
                "hint": "默认为空，使用 `/sd scheduler list` 获取，使用 `/sd scheduler set <index>` 设置"
            },
            "cfg_scale": {
                "type": "float",
                "description": "CFG比例",
                "default": 7.0,
                "min": 1.0,
                "max": 20.0
            },
            "upscaler": {
                "type": "string",
                "description": "上采样算法",
                "default": "",
                "hint": "默认为空，使用 `/sd upscaler list` 获取，使用 `/sd upscaler set <index>` 设置"
            },
            "upscale_factor": {
                "type": "float",
                "description": "图像放大倍数",
                "default": 2.0,
                "min": 1.0,
                "max": 8.0,
                "hint": "放大倍数，例如1.1, 1.2, 2.0等"
            },
            "batch_size": {
                "type": "int",
                "description": "每批数量",
                "default": 1
            },
            "n_iter": {
                "type": "int",
                "description": "迭代次数",
                "default": 1
            }
        }
    },
    "img2img_params": {
        "type": "object",
        "description": "图生图默认生成参数",
        "items": {
            "denoising_strength": {
                "type": "float",
                "description": "重绘幅度",
                "default": 0.75,
                "min": 0.0,
                "max": 1.0,
                "hint": "重绘幅度，范围0.0~1.0"
            },
            "steps": {
                "type": "int",
                "description": "步数",
                "default": 20,
                "min": 10,
                "max": 50
            },
            "sampler": {
                "type": "string",
                "description": "采样器",
                "default": "",
                "hint": "默认为空，使用 `/sd sampler list` 获取，使用 `/sd sampler set <index>` 设置"
            },
            "scheduler": {
                "type": "string",
                "description": "调度器",
                "default": "",
                "hint": "默认为空，使用 `/sd scheduler list` 获取，使用 `/sd scheduler set <index>` 设置"
            },
            "cfg_scale": {
                "type": "float",
                "description": "CFG比例",
                "default": 7.0,
                "min": 1.0,
                "max": 20.0
            },
            "batch_size": {
                "type": "int",
                "description": "每批数量",
                "default": 1
            },
            "n_iter": {
                "type": "int",
                "description": "迭代次数",
                "default": 1
            }
        }
    },
    "enable_img2img_generate_prompt": {
        "type": "bool",
        "description": "启用使用LLM生成图生图正向提示词",
        "default": true,
        "hint": "设置为true时启用"
    },
    "base_model": {
        "type": "string",
        "description": "基础模型",
        "default": "",
        "hint": "默认为空，使用 `/sd model list` 获取，使用 `/sd model set <index>` 设置"
    },
    "prompt_guidelines": {
        "type": "string",
        "description": "LLM生成提示词时的附加限制",
        "default": "",
        "hint": "屏蔽色情内容等, 例如`任何被判断为色情的提示词都应该被替换，避免出现色情内容`"
    },
    "img2img_prompt_prefix_new": {
        "type": "string",
        "description": "图生图正向提示词前缀（新版字段名，测试用）。仅用于图生图流程。若未设置，则使用 positive_prompt_global。",
        "default": "",
        "hint": "通过 /sd i2i prompt_prefix 设置和查询"
    }
}
